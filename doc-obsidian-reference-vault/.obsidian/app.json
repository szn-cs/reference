{
  "readableLineLength": false,
  "userIgnoreFilters": [
    "/^(?!(?:doc-[^/]+|\\.obsidian|templates)(?:\\/|$)).+\\//",
    "/^doc-work\\/logseq\\//"
  ],
  "useMarkdownLinks": true,
